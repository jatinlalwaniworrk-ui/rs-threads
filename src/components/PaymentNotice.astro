---
// Payment safety notice: on Contact, Terms of trade and in the footer. Never add bank details to the site.
import Text from './Text.astro';
import type { Strings } from '../i18n';

interface Props {
  t: Strings;
  headingLevel?: 'h2' | 'h3';
}

const { t, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
---
<div class="payment-note" role="note">
  <Heading>{t.payment.title}</Heading>
  <p><Text t={t.payment.text} /></p>
</div>
